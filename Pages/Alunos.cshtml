@page
@model AlunosModel
@{
    ViewData["Title"] = "Alunos";
}

<div class="page-header">
    <div>
        <h1>GESTÃO DE <span>ALUNOS</span></h1>
        <p>Cadastre alunos, planos, metas de graduação e acompanhe a evolução no tatame.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensagem))
{
    <div class="alert-success">@Model.Mensagem</div>
}

<div class="panel">
    <h2 class="panel-title"><i data-lucide="user-plus"></i> Cadastrar Novo Aluno</h2>
    <form method="post" asp-page-handler="Criar">
        <div class="form-grid">
            <div class="form-group">
                <label>Nome Completo *</label>
                <input asp-for="NovoAluno.Nome" class="form-control" placeholder="Ex: João Vitor" required />
            </div>

            <div class="form-group">
                <label>CPF * (Chave Convênio)</label>
                <input asp-for="NovoAluno.Cpf" class="form-control" placeholder="000.000.000-00" required />
            </div>

            <div class="form-group">
                <label>WhatsApp / Telefone</label>
                <input asp-for="NovoAluno.Telefone" class="form-control" placeholder="(31) 99999-9999" />
            </div>

            <div class="form-group">
                <label>Modalidade Principal</label>
                <select asp-for="NovoAluno.ModalidadePrincipal" class="form-control">
                    <option value="Muay Thai">Muay Thai</option>
                    <option value="Jiu-Jitsu">Jiu-Jitsu</option>
                    <option value="Boxe">Boxe</option>
                </select>
            </div>

            <div class="form-group">
                <label>Vínculo / Plano</label>
                <select asp-for="NovoAluno.TipoPlano" class="form-control">
                    <option value="Direto">Plano Direto (Academia)</option>
                    <option value="Wellhub">Wellhub (Gympass)</option>
                    <option value="TotalPass">TotalPass</option>
                </select>
            </div>

            <div class="form-group">
                <label>Graduação / Nível Atual</label>
                <input asp-for="NovoAluno.GraduacaoAtual" class="form-control" value="Faixa Branca / Iniciante" />
            </div>

            <div class="form-group">
                <label>Aulas Já Feitas na Faixa</label>
                <input asp-for="NovoAluno.AulasNaGraduacaoAtual" type="number" min="0" class="form-control" value="0" />
            </div>

            <div class="form-group">
                <label>Meta de Aulas p/ Graduar</label>
                <input asp-for="NovoAluno.MetaAulasGraduacao" type="number" min="1" class="form-control" value="40" />
            </div>
        </div>

        <div style="margin-top: 20px;">
            <button type="submit" class="btn btn-primary"><i data-lucide="save"></i> Salvar Aluno</button>
        </div>
    </form>
</div>

<div class="panel">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin-bottom: 20px;">
        <h2 class="panel-title" style="margin-bottom: 0;"><i data-lucide="users"></i> Alunos Cadastrados (@Model.ListaAlunos.Count)</h2>
        
        <form method="get" style="display: flex; gap: 8px;">
            <input type="text" name="Busca" value="@Model.Busca" class="form-control" placeholder="Buscar por nome ou CPF..." style="min-width: 240px;" />
            <button type="submit" class="btn btn-outline btn-sm">Buscar</button>
            @if (!string.IsNullOrEmpty(Model.Busca))
            {
                <a asp-page="/Alunos" class="btn btn-outline btn-sm">Limpar</a>
            }
        </form>
    </div>

    @if (!Model.ListaAlunos.Any())
    {
        <p style="color: var(--text-muted);">Nenhum aluno encontrado.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Modalidade / Plano</th>
                        <th>Graduação</th>
                        <th>Evolução p/ Próxima</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aluno in Model.ListaAlunos)
                    {
                        <tr>
                            <td>
                                <strong>@aluno.Nome</strong><br />
                                <small style="color: var(--text-muted);">CPF: @aluno.Cpf</small>
                            </td>
                            <td>
                                <strong>@aluno.ModalidadePrincipal</strong><br />
                                <span class="badge badge-@aluno.TipoPlano.ToLower()">@aluno.TipoPlano</span>
                            </td>
                            <td>@aluno.GraduacaoAtual</td>
                            <td style="min-width: 190px;">
                                <div style="display: flex; justify-content: space-between; font-size: 0.8rem; margin-bottom: 4px;">
                                    <span>@aluno.AulasNaGraduacaoAtual / @aluno.MetaAulasGraduacao aulas</span>
                                    <strong style="color: var(--primary);">@aluno.PercentualEvolucao%</strong>
                                </div>
                                <div style="width: 100%; height: 8px; background-color: #262626; border-radius: 99px; overflow: hidden;">
                                    <div style="width: @(aluno.PercentualEvolucao)%; height: 100%; background-color: var(--primary);"></div>
                                </div>
                                <small style="color: var(--text-muted); font-size: 0.75rem;">
                                    @(aluno.AulasFaltantes == 0 ? "Apto para graduar!" : $"Faltam {aluno.AulasFaltantes} aulas")
                                </small>
                            </td>
                            <td><span class="badge badge-@aluno.Status.ToLower()">@aluno.Status</span></td>
                            <td>
                                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                    <form method="post" asp-page-handler="Graduar" asp-route-id="@aluno.Id" onsubmit="const nova = prompt('Qual a nova graduação/faixa de @aluno.Nome?'); if(!nova) return false; this.querySelector('input[name=novaGraduacao]').value = nova;">
                                        <input type="hidden" name="novaGraduacao" />
                                        <button type="submit" class="btn btn-outline btn-sm" style="border-color: var(--primary); color: #FCA5A5;">Graduar</button>
                                    </form>
                                    <form method="post" asp-page-handler="AlternarStatus" asp-route-id="@aluno.Id">
                                        <button type="submit" class="btn btn-outline btn-sm">
                                            @(aluno.Status == "Ativo" ? "Desativar" : "Ativar")
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Excluir" asp-route-id="@aluno.Id" onsubmit="return confirm('Excluir este aluno?');">
                                        <button type="submit" class="btn btn-outline btn-sm" style="border-color: #7f1d1d; color: #fca5a5;">X</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>