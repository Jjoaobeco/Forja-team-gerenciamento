@page
@model ForjaTeamApp.Pages.LoginModel
@{
    ViewData["Title"] = "Entrar";
}

<style>
    .login-wrapper {
        min-height: calc(100vh - 180px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 12px;
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        background: #141417;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-top: 3px solid #DC2626;
        border-radius: 14px;
        padding: 32px 28px;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
        color: #f4f4f5;
    }

    .login-header {
        text-align: center;
        margin-bottom: 24px;
    }

    .login-logo {
        width: 68px;
        height: 68px;
        object-fit: contain;
        margin-bottom: 10px;
    }

    .login-title {
        font-family: 'Oswald', sans-serif;
        font-size: 1.75rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin: 0;
        color: #ffffff;
    }

    .login-title span {
        color: #DC2626;
    }

    .login-subtitle {
        font-size: 0.875rem;
        color: #a1a1aa;
        margin-top: 4px;
    }

    .login-field {
        margin-bottom: 16px;
    }

    .login-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #d4d4d8;
        margin-bottom: 6px;
        letter-spacing: 0.02em;
    }

    .login-input {
        width: 100%;
        padding: 11px 14px;
        border-radius: 8px;
        border: 1px solid #27272a;
        background: #0c0c0e;
        color: #ffffff;
        font-size: 0.95rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }

    .login-input:focus {
        outline: none;
        border-color: #DC2626;
        box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.22);
    }

    .login-btn {
        width: 100%;
        padding: 12px;
        margin-top: 6px;
        border: none;
        border-radius: 8px;
        background: #DC2626;
        color: #ffffff;
        font-family: 'Oswald', sans-serif;
        font-size: 1.05rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
    }

    .login-btn:hover {
        background: #b91c1c;
    }

    .login-btn:active {
        transform: scale(0.99);
    }

    .login-alert {
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        margin-bottom: 16px;
    }

    .login-alert-error {
        background: rgba(220, 38, 38, 0.15);
        border: 1px solid rgba(220, 38, 38, 0.45);
        color: #fca5a5;
    }

    .login-alert-success {
        background: rgba(22, 163, 74, 0.15);
        border: 1px solid rgba(22, 163, 74, 0.45);
        color: #86efac;
    }

    .login-divider {
        border: none;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        margin: 22px 0 16px;
    }

    .login-footer-text {
        text-align: center;
        font-size: 0.85rem;
        color: #a1a1aa;
    }

    .login-link {
        color: #f87171;
        font-weight: 600;
        text-decoration: none;
        margin-left: 4px;
    }

    .login-link:hover {
        color: #fca5a5;
        text-decoration: underline;
    }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <img src="~/logo2.png" alt="Logo Forja Team" class="login-logo" />
            <h1 class="login-title">FORJA <span>TEAM</span></h1>
            <p class="login-subtitle">Acesse com seu CPF ou usuário e senha</p>
        </div>

        @if (Model.Cadastrado)
        {
            <div class="login-alert login-alert-success">
                Senha definida com sucesso! Faça login para acessar sua área.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Erro))
        {
            <div class="login-alert login-alert-error">
                @Model.Erro
            </div>
        }

        <form method="post">
            <div class="login-field">
                <label asp-for="Identificador" class="login-label">CPF ou Usuário</label>
                <input asp-for="Identificador"
                       class="login-input"
                       placeholder="Ex.: 000.000.000-00"
                       autocomplete="username" />
            </div>

            <div class="login-field">
                <label asp-for="Senha" class="login-label">Senha</label>
                <input asp-for="Senha"
                       type="password"
                       class="login-input"
                       placeholder="Digite sua senha"
                       autocomplete="current-password" />
            </div>

            <button type="submit" class="login-btn">Entrar</button>
        </form>

        <hr class="login-divider" />

        <div class="login-footer-text">
            Primeiro acesso?
            <a asp-page="/Cadastrar" class="login-link">Definir senha com CPF</a>
        </div>
    </div>
</div>