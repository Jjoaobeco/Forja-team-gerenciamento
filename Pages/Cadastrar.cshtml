@page
@model ForjaTeamApp.Pages.CadastrarModel
@{
    ViewData["Title"] = "Definir Senha — Forja Team";
}

<div class="container py-5" style="max-width: 440px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h2 class="h4 fw-bold mb-1">Definir Senha do Aluno</h2>
            <p class="text-muted small mb-4">Use o CPF já cadastrado pela academia para criar sua senha de acesso.</p>

            @if (!string.IsNullOrWhiteSpace(Model.Erro))
            {
                <div class="alert alert-danger py-2 small">
                    @Model.Erro
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Cpf" class="form-label">Seu CPF cadastrado</label>
                    <input asp-for="Cpf" class="form-control" placeholder="Ex.: 000.000.000-00" />
                </div>

                <div class="mb-3">
                    <label asp-for="Senha" class="form-label">Crie sua senha</label>
                    <input asp-for="Senha" type="password" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmarSenha" class="form-label">Confirme sua senha</label>
                    <input asp-for="ConfirmarSenha" type="password" class="form-control" />
                </div>

                <button type="submit" class="btn btn-dark w-100 py-2">Salvar Senha</button>
            </form>

            <hr class="my-4" />

            <div class="text-center small">
                Já definiu sua senha?
                <a asp-page="/Login" class="fw-semibold text-decoration-none">Fazer login</a>
            </div>
        </div>
    </div>
</div>