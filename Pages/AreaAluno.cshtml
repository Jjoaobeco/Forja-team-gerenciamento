@page
@model ForjaTeamApp.Pages.AreaAlunoModel
@{
    ViewData["Title"] = "Área do Aluno";
}

<div class="page-header">
    <div>
        <h1>ÁREA DO <span>ALUNO</span></h1>
        <p>Acompanhe sua graduação, frequência no tatame e posição no ranking.</p>
    </div>

    @if (Model.PodeTrocarAluno && Model.TodosAlunos.Any())
    {
        <form method="get" style="display: flex; align-items: center; gap: 8px;">
            <label style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Visualizar como:</label>
            <select name="AlunoId" class="form-control" onchange="this.form.submit()" style="min-width: 220px;">
                @foreach (var a in Model.TodosAlunos)
                {
                    <option value="@a.Id" selected="@(Model.AlunoSelecionado?.Id == a.Id)">@a.Nome</option>
                }
            </select>
        </form>
    }
</div>

@if (Model.AlunoSelecionado == null)
{
    <div class="panel">
        <p style="color: var(--text-muted); margin-bottom: 14px;">Nenhum aluno cadastrado ainda para exibir a carteira.</p>
        <a asp-page="/Alunos" class="btn btn-primary btn-sm"><i data-lucide="user-plus"></i> Cadastrar Aluno</a>
    </div>
}
else
{
    var aluno = Model.AlunoSelecionado;

    <!-- CARD PRINCIPAL DE EVOLUÇÃO -->
    <div class="panel" style="border-top: 4px solid var(--primary);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
            <div>
                <span style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 2px; color: var(--primary); font-weight: 700;">
                    @aluno.ModalidadePrincipal • @aluno.TipoPlano
                </span>
                <h2 style="font-family: var(--font-heading); font-size: 1.9rem; margin-top: 2px;">@aluno.Nome</h2>
                <span class="badge badge-@aluno.Status.ToLower()">@aluno.Status</span>
            </div>

            <div style="background-color: var(--bg-main); border: 1px solid var(--border); padding: 14px 22px; border-radius: 10px; text-align: center;">
                <span style="display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted);">Graduação Atual</span>
                <strong style="font-family: var(--font-heading); font-size: 1.3rem; color: var(--text-main);">@aluno.GraduacaoAtual</strong>
            </div>
        </div>

        <!-- CONTADORES LADO A LADO -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <div style="background-color: var(--bg-main); border: 1px solid var(--border); border-radius: 10px; padding: 22px; text-align: center;">
                <strong style="font-family: var(--font-heading); font-size: 2.8rem; line-height: 1; display: block;">@aluno.AulasNaGraduacaoAtual</strong>
                <span style="color: var(--text-muted); font-size: 0.85rem;">Aulas realizadas na graduação atual</span>
            </div>

            <div style="background-color: var(--primary); border-radius: 10px; padding: 22px; text-align: center; color: #fff;">
                <strong style="font-family: var(--font-heading); font-size: 2.8rem; line-height: 1; display: block;">@aluno.AulasFaltantes</strong>
                <span style="font-size: 0.85rem; opacity: 0.92;">Aulas para a próxima graduação</span>
            </div>

            <div style="background-color: var(--bg-main); border: 1px solid var(--border); border-radius: 10px; padding: 22px; text-align: center;">
                <strong style="font-family: var(--font-heading); font-size: 2.8rem; line-height: 1; display: block; color: var(--primary);">@(Model.PosicaoRanking > 0 ? $"#{Model.PosicaoRanking}" : "-")</strong>
                <span style="color: var(--text-muted); font-size: 0.85rem;">Posição no Ranking da Academia</span>
            </div>
        </div>

        <!-- BARRA DE PROGRESSO -->
        <div>
            <div style="display: flex; justify-content: space-between; font-size: 0.88rem; margin-bottom: 8px;">
                <span style="color: var(--text-muted);">Progresso para a próxima graduação</span>
                <strong style="color: var(--primary);">@aluno.PercentualEvolucao% concluído</strong>
            </div>
            <div style="width: 100%; height: 14px; background-color: var(--bg-main); border: 1px solid var(--border); border-radius: 99px; overflow: hidden;">
                <div style="width: @(aluno.PercentualEvolucao)%; height: 100%; background-color: var(--primary); transition: width 0.4s ease;"></div>
            </div>
        </div>
    </div>

    <!-- ATALHOS RÁPIDOS -->
    <div class="stats-grid">
        <a asp-page="/Checkin" class="stat-card" style="transition: var(--transition);">
            <div class="stat-info">
                <span>Fazer Check-in</span>
                <strong style="font-size: 1.35rem;">REGISTRAR TREINO</strong>
            </div>
            <div class="stat-icon"><i data-lucide="qr-code"></i></div>
        </a>

        <a asp-page="/Cronometro" class="stat-card" style="transition: var(--transition);">
            <div class="stat-info">
                <span>Timer de Round</span>
                <strong style="font-size: 1.35rem;">CRONÔMETRO</strong>
            </div>
            <div class="stat-icon"><i data-lucide="timer"></i></div>
        </a>

        <a asp-page="/Turmas" class="stat-card" style="transition: var(--transition);">
            <div class="stat-info">
                <span>Horários</span>
                <strong style="font-size: 1.35rem;">GRADE DE AULAS</strong>
            </div>
            <div class="stat-icon"><i data-lucide="calendar"></i></div>
        </a>
    </div>

    <!-- HISTÓRICO & RANKING LADO A LADO -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        <div class="panel">
            <h2 class="panel-title"><i data-lucide="history"></i> Últimos Treinos de @aluno.Nome</h2>
            @if (!Model.HistoricoTreinos.Any())
            {
                <p style="color: var(--text-muted);">Nenhum check-in registrado ainda para este aluno.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Aula</th>
                                <th>Via</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.HistoricoTreinos)
                            {
                                <tr>
                                    <td>@item.DataHora.ToString("dd/MM HH:mm")</td>
                                    <td>@item.Turma?.Modalidade (@item.Turma?.Categoria)</td>
                                    <td><span class="badge badge-@item.Origem.ToLower()">@item.Origem</span></td>
                                    <td>
                                        @if (item.Validada)
                                        {
                                            <span class="badge badge-ativo">Confirmado</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pendente">Aguardando Admin</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="panel">
            <h2 class="panel-title"><i data-lucide="trophy"></i> Ranking de Frequência</h2>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Pos.</th>
                            <th>Aluno</th>
                            <th>Modalidade</th>
                            <th>Treinos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Ranking.Count; i++)
                        {
                            var r = Model.Ranking[i];
                            <tr style="@(r.Id == aluno.Id ? "background-color: rgba(220, 38, 38, 0.12);" : "")">
                                <td><strong>#@(i + 1)</strong></td>
                                <td><strong>@r.Nome</strong></td>
                                <td>@r.ModalidadePrincipal</td>
                                <td><strong>@r.Presencas.Count(p => p.Validada)</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}