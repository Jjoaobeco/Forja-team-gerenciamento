@page
@model DebitosModel
@{
    ViewData["Title"] = "Débitos e Planos";
}

<div class="page-header">
    <div>
        <h1>DÉBITOS & <span>PLANOS</span></h1>
        <p>Controle de mensalidades do Plano Direto e validação de convênios Wellhub / TotalPass.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensagem))
{
    <div class="alert-success">@Model.Mensagem</div>
}

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <span>Receita Direta (Ativos)</span>
            <strong>R$ @Model.ReceitaMensalPrevista.ToString("N2")</strong>
        </div>
        <div class="stat-icon"><i data-lucide="wallet"></i></div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span>Mensalidades Pendentes</span>
            <strong>@Model.PendentesCount</strong>
        </div>
        <div class="stat-icon"><i data-lucide="alert-circle"></i></div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span>Alunos Convênio</span>
            <strong>@Model.ConveniosCount</strong>
        </div>
        <div class="stat-icon"><i data-lucide="shield-check"></i></div>
    </div>
</div>

<div class="panel">
    <h2 class="panel-title"><i data-lucide="receipt"></i> Situação Financeira por Aluno</h2>

    @if (!Model.Alunos.Any())
    {
        <p style="color: var(--text-muted);">Nenhum aluno cadastrado ainda.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Plano</th>
                        <th>Mensalidade</th>
                        <th>Vencimento</th>
                        <th>Situação</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aluno in Model.Alunos)
                    {
                        var ehConvenio = aluno.TipoPlano == "Wellhub" || aluno.TipoPlano == "TotalPass";
                        <tr>
                            <td>
                                <strong>@aluno.Nome</strong><br />
                                <small style="color: var(--text-muted);">CPF: @aluno.Cpf</small>
                            </td>
                            <td><span class="badge badge-@aluno.TipoPlano.ToLower()">@aluno.TipoPlano</span></td>
                            <td>
                                @if (ehConvenio)
                                {
                                    <span style="color: var(--text-muted);">Repasse Convênio</span>
                                }
                                else
                                {
                                    <strong>R$ @aluno.ValorMensalidade.ToString("N2")</strong>
                                }
                            </td>
                            <td>
                                @if (ehConvenio)
                                {
                                    <span style="color: var(--text-muted);">Via Check-in</span>
                                }
                                else
                                {
                                    @(aluno.ProximoVencimento?.ToString("dd/MM/yyyy") ?? "-")
                                }
                            </td>
                            <td>
                                @if (ehConvenio)
                                {
                                    <span class="badge badge-ativo">Liberado Convênio</span>
                                }
                                else if (aluno.SituacaoPagamento == "Em Dia")
                                {
                                    <span class="badge badge-ativo">Em Dia</span>
                                }
                                else
                                {
                                    <span class="badge badge-direto">Pendente</span>
                                }
                            </td>
                            <td>
                                @if (!ehConvenio)
                                {
                                    <div style="display: flex; gap: 6px;">
                                        <form method="post" asp-page-handler="MarcarPago" asp-route-id="@aluno.Id">
                                            <button type="submit" class="btn btn-primary btn-sm">Confirmar Pagto</button>
                                        </form>
                                        @if (aluno.SituacaoPagamento == "Em Dia")
                                        {
                                            <form method="post" asp-page-handler="MarcarPendente" asp-route-id="@aluno.Id">
                                                <button type="submit" class="btn btn-outline btn-sm">Pendente</button>
                                            </form>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <small style="color: var(--text-muted);">Sem cobrança direta</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>