@page
@model DebitosModel
@{
    ViewData["Title"] = "Débitos e Planos";
    var filtroAtual = (Model.Filtro ?? "todos").ToLowerInvariant();
}

<div class="page-header">
    <div>
        <h1>DÉBITOS & <span>PLANOS</span></h1>
        <p>Controle de mensalidades do Plano Direto e repasses de convênios Wellhub / TotalPass.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensagem))
{
    <div class="alert-success">@Model.Mensagem</div>
}

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <span>Receita Direta (Ativos)</span>
            <strong>R$ @Model.ReceitaMensalPrevista.ToString("N2")</strong>
        </div>
        <div class="stat-icon"><i data-lucide="wallet"></i></div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span>Mensalidades Pendentes</span>
            <strong>@Model.PendentesCount</strong>
        </div>
        <div class="stat-icon"><i data-lucide="alert-circle"></i></div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span>Repasse Convênios (Mês)</span>
            <strong>R$ @Model.ReceitaConveniosMes.ToString("N2")</strong>
            <small style="display: block; color: var(--text-muted); font-size: 0.75rem; margin-top: 2px;">
                @Model.ConveniosCount alunos • Silver R$ @Model.ValorCheckinWellhub.ToString("N2") | TotalPass R$ @Model.ValorCheckinTotalPass.ToString("N2")
            </small>
        </div>
        <div class="stat-icon"><i data-lucide="shield-check"></i></div>
    </div>
</div>

<div class="panel">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin-bottom: 20px;">
        <h2 class="panel-title" style="margin-bottom: 0;"><i data-lucide="receipt"></i> Situação Financeira por Aluno</h2>

        <form method="get" style="display: flex; gap: 8px; flex-wrap: wrap;">
            <input type="hidden" name="Filtro" value="@filtroAtual" />
            <input type="text"
                   name="Busca"
                   value="@Model.Busca"
                   class="form-control"
                   placeholder="Buscar por nome ou CPF..."
                   style="min-width: 220px;" />
            <button type="submit" class="btn btn-primary btn-sm">Buscar</button>
            @if (!string.IsNullOrWhiteSpace(Model.Busca))
            {
                <a asp-page="/Debitos" asp-route-Filtro="@filtroAtual" class="btn btn-outline btn-sm">Limpar</a>
            }
        </form>
    </div>

    <!-- ABAS / BOTÕES DE FILTRO -->
    <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px;">
        <a asp-page="/Debitos"
           asp-route-Filtro="todos"
           asp-route-Busca="@Model.Busca"
           class="btn btn-sm @(filtroAtual == "todos" ? "btn-primary" : "btn-outline")">
            Todos (@Model.TotalCount)
        </a>

        <a asp-page="/Debitos"
           asp-route-Filtro="pagos"
           asp-route-Busca="@Model.Busca"
           class="btn btn-sm @(filtroAtual == "pagos" ? "btn-primary" : "btn-outline")">
            Pagos / Em Dia (@Model.PagosCount)
        </a>

        <a asp-page="/Debitos"
           asp-route-Filtro="pendentes"
           asp-route-Busca="@Model.Busca"
           class="btn btn-sm @(filtroAtual == "pendentes" ? "btn-primary" : "btn-outline")">
            Pendentes (@Model.PendentesCount)
        </a>

        <a asp-page="/Debitos"
           asp-route-Filtro="convenios"
           asp-route-Busca="@Model.Busca"
           class="btn btn-sm @(filtroAtual == "convenios" ? "btn-primary" : "btn-outline")">
            Convênios (@Model.ConveniosCount)
        </a>
    </div>

    @if (!Model.Alunos.Any())
    {
        <p style="color: var(--text-muted);">Nenhum aluno encontrado para o filtro selecionado.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Plano</th>
                        <th>Valor / Repasse Mês</th>
                        <th>Vencimento / Check-ins</th>
                        <th>Situação</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aluno in Model.Alunos)
                    {
                        var ehConvenio = aluno.TipoPlano == "Wellhub" || aluno.TipoPlano == "TotalPass";
                        var checkinsMes = Model.CheckinsMesPorAluno.GetValueOrDefault(aluno.Id, 0);
                        var tarifaConvenio = aluno.TipoPlano == "Wellhub" ? Model.ValorCheckinWellhub : Model.ValorCheckinTotalPass;
                        var repasseAlunoMes = checkinsMes * tarifaConvenio;

                        <tr>
                            <td>
                                <strong>@aluno.Nome</strong><br />
                                <small style="color: var(--text-muted);">CPF: @aluno.Cpf</small>
                            </td>
                            <td><span class="badge badge-@aluno.TipoPlano.ToLower()">@aluno.TipoPlano</span></td>
                            <td>
                                @if (ehConvenio)
                                {
                                    <strong>R$ @repasseAlunoMes.ToString("N2")</strong><br />
                                    <small style="color: var(--text-muted);">R$ @tarifaConvenio.ToString("N2") / check-in</small>
                                }
                                else
                                {
                                    <strong>R$ @aluno.ValorMensalidade.ToString("N2")</strong>
                                }
                            </td>
                            <td>
                                @if (ehConvenio)
                                {
                                    <span>@checkinsMes check-in(s) validado(s) no mês</span>
                                }
                                else
                                {
                                    @(aluno.ProximoVencimento?.ToString("dd/MM/yyyy") ?? "-")
                                }
                            </td>
                            <td>
                                @if (ehConvenio)
                                {
                                    <span class="badge badge-ativo">Liberado Convênio</span>
                                }
                                else if (aluno.SituacaoPagamento == "Em Dia")
                                {
                                    <span class="badge badge-ativo">Em Dia</span>
                                }
                                else
                                {
                                    <span class="badge badge-direto">Pendente</span>
                                }
                            </td>
                            <td>
                                @if (!ehConvenio)
                                {
                                    <div style="display: flex; gap: 6px;">
                                        <form method="post"
                                              asp-page-handler="MarcarPago"
                                              asp-route-id="@aluno.Id"
                                              asp-route-filtro="@filtroAtual"
                                              asp-route-busca="@Model.Busca">
                                            <button type="submit" class="btn btn-primary btn-sm">Confirmar Pagto</button>
                                        </form>
                                        @if (aluno.SituacaoPagamento == "Em Dia")
                                        {
                                            <form method="post"
                                                  asp-page-handler="MarcarPendente"
                                                  asp-route-id="@aluno.Id"
                                                  asp-route-filtro="@filtroAtual"
                                                  asp-route-busca="@Model.Busca">
                                                <button type="submit" class="btn btn-outline btn-sm">Pendente</button>
                                            </form>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <small style="color: var(--text-muted);">Repasse via portal</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>