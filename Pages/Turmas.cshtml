@page
@model TurmasModel
@{
    ViewData["Title"] = "Turmas";
}

<div class="page-header">
    <div>
        <h1>GRADE DE <span>TURMAS</span></h1>
        <p>Modalidades, categorias e professores da Forja Team.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensagem))
{
    <div class="alert-success">@Model.Mensagem</div>
}

<div class="panel">
    <h2 class="panel-title"><i data-lucide="calendar-plus"></i> Adicionar Turma</h2>
    <form method="post">
        <div class="form-grid">
            <div class="form-group">
                <label>Modalidade *</label>
                <input asp-for="NovaTurma.Modalidade" class="form-control" placeholder="Ex: Muay Thai, Jiu-Jitsu, Boxe" required />
            </div>

            <div class="form-group">
                <label>Categoria *</label>
                <input asp-for="NovaTurma.Categoria" class="form-control" placeholder="Ex: Adulto, Feminino, Kids, Baby" required />
            </div>

            <div class="form-group">
                <label>Dia da Semana *</label>
                <select asp-for="NovaTurma.DiaSemana" class="form-control">
                    <option value="Segunda">Segunda</option>
                    <option value="Terça">Terça</option>
                    <option value="Quarta">Quarta</option>
                    <option value="Quinta">Quinta</option>
                    <option value="Sexta">Sexta</option>
                </select>
            </div>

            <div class="form-group">
                <label>Horário *</label>
                <input asp-for="NovaTurma.Horario" class="form-control" placeholder="Ex: 19:00" required />
            </div>

            <div class="form-group">
                <label>Professor</label>
                <input asp-for="NovaTurma.Professor" class="form-control" placeholder="Ex: Professor Rômulo" />
            </div>
        </div>

        <div style="margin-top: 20px;">
            <button type="submit" class="btn btn-primary"><i data-lucide="plus"></i> Cadastrar Turma</button>
        </div>
    </form>
</div>

<div class="panel">
    <h2 class="panel-title"><i data-lucide="calendar"></i> Turmas Cadastradas (@Model.ListaTurmas.Count)</h2>
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Dia</th>
                    <th>Horário</th>
                    <th>Modalidade</th>
                    <th>Categoria</th>
                    <th>Professor</th>
                    <th>Presenças</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var turma in Model.ListaTurmas)
                {
                    <tr>
                        <td><strong>@turma.DiaSemana</strong></td>
                        <td>@turma.Horario</td>
                        <td>@turma.Modalidade</td>
                        <td>@turma.Categoria</td>
                        <td>@turma.Professor</td>
                        <td><strong>@turma.Presencas.Count</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>