@page
@model IndexModel
@{
    ViewData["Title"] = "Painel Geral";
}

<div class="page-header">
    <div>
        <h1>PAINEL <span>FORJA TEAM</span></h1>
        <p>Visão geral de alunos, convênios e presença no tatame.</p>
    </div>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <a asp-page="/Checkin" class="btn btn-primary"><i data-lucide="qr-code"></i> Registrar Check-in</a>
        <a asp-page="/Alunos" class="btn btn-outline"><i data-lucide="user-plus"></i> Novo Aluno</a>
    </div>
</div>

@if (Model.CheckinsPendentes > 0 || Model.MensalidadesPendentes > 0)
{
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; margin-bottom: 24px;">
        @if (Model.CheckinsPendentes > 0)
        {
            <div style="background-color: rgba(245, 158, 11, 0.14); border: 1px solid rgba(245, 158, 11, 0.45); border-radius: 10px; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 10px; color: #FCD34D;">
                    <i data-lucide="clock"></i>
                    <div>
                        <strong style="display: block; font-size: 0.92rem;">@Model.CheckinsPendentes check-in(s) aguardando autorização</strong>
                        <small style="opacity: 0.85;">Solicitações enviadas pelos alunos pelo app.</small>
                    </div>
                </div>
                <a asp-page="/Checkin" class="btn btn-primary btn-sm" style="white-space: nowrap;">Revisar</a>
            </div>
        }

        @if (Model.MensalidadesPendentes > 0)
        {
            <div style="background-color: rgba(220, 38, 38, 0.14); border: 1px solid rgba(220, 38, 38, 0.45); border-radius: 10px; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 10px; color: #FCA5A5;">
                    <i data-lucide="alert-circle"></i>
                    <div>
                        <strong style="display: block; font-size: 0.92rem;">@Model.MensalidadesPendentes mensalidade(s) pendente(s)</strong>
                        <small style="opacity: 0.85;">Alunos do plano direto com pagamento em aberto.</small>
                    </div>
                </div>
                <a asp-page="/Debitos" asp-route-Filtro="pendentes" class="btn btn-outline btn-sm" style="white-space: nowrap;">Ver Débitos</a>
            </div>
        }
    </div>
}

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-info">
            <span>Alunos Ativos</span>
            <strong>@Model.TotalAlunosAtivos</strong>
        </div>
        <div class="stat-icon"><i data-lucide="users"></i></div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span>Check-ins Hoje</span>
            <strong>@Model.CheckinsHoje</strong>
        </div>
        <div class="stat-icon"><i data-lucide="check-circle"></i></div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span>Wellhub / TotalPass</span>
            <strong>@Model.AlunosConvenio</strong>
        </div>
        <div class="stat-icon"><i data-lucide="credit-card"></i></div>
    </div>

    <div class="stat-card">
        <div class="stat-info">
            <span>Turmas na Grade</span>
            <strong>@Model.TotalTurmas</strong>
        </div>
        <div class="stat-icon"><i data-lucide="calendar"></i></div>
    </div>
</div>

<div class="panel">
    <h2 class="panel-title"><i data-lucide="activity"></i> Últimos Check-ins no Tatame</h2>

    @if (!Model.UltimasPresencas.Any())
    {
        <p style="color: var(--text-muted);">Nenhum check-in confirmado ainda. Cadastre um aluno e registre a primeira presença!</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Data / Hora</th>
                        <th>Aluno</th>
                        <th>Turma</th>
                        <th>Professor</th>
                        <th>Origem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.UltimasPresencas)
                    {
                        <tr>
                            <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong>@item.Aluno?.Nome</strong></td>
                            <td>@item.Turma?.Modalidade (@item.Turma?.Categoria) - @item.Turma?.Horario</td>
                            <td>@item.Turma?.Professor</td>
                            <td>
                                <span class="badge badge-@item.Origem.ToLower()">@item.Origem</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>